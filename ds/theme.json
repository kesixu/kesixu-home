{
  "name": "划亮 Strike a Light",
  "worldview": "一间黑屋子，唯一光源是访客亲手划亮的火柴；一切可见之物都被火光照亮，而非自己发光",
  "color": {
    "ink": "#0d0b09",
    "char": "#2a2019",
    "ember": "#b33a1e",
    "flame": "#ff6b35",
    "amber": "#ffa94d",
    "gold": "#ffd28a",
    "paper": "#f2ece1",
    "smoke": "#8a8378",
    "rule": "唯一色系=火焰光谱；文字只用 paper/smoke；禁止新增色相；禁纯黑"
  },
  "type": {
    "display": "LXGW WenKai Medium",
    "echo": "EB Garamond Italic",
    "body": "system CJK stack",
    "rule": "名字竖排；英文只做小声回声；正文零下载系统栈"
  },
  "glow": {
    "sm": "灯芯",
    "md": "标题",
    "lg": "名字/火头",
    "rule": "辉光即层级，代替边框和分割线"
  },
  "motion": {
    "input": "scroll only",
    "props": "transform/opacity only",
    "memory": "点过的灯不熄(once)",
    "pace": "reveal 1.0-1.1s power2.out; scrub 0.4-0.5",
    "baseline": "无JS/reduced/异常=静态可读"
  },
  "source_of_truth": "kumo:~/projects/kesixu-home (site/ 为部署产物, ds/ 为本设计系统)"
}