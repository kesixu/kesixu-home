  "textlines": {
   "whisper": [
    "长夜未央。",
    "先取一根火柴。"
   ],
   "tagline": [
    "格物于毫厘，点灯于长夜。"
   ],
   "heroEcho": [
    "计算病理出身，做医学与智能之间的转化。"
   ],
   "chapterSub": [
    "薪火相传，次第点亮。"
   ],
   "skyline": [
    "点过的灯，抬头再看，",
    "已成星斗。"
   ],
   "skyEcho": [
    "维北有斗，七星在野。"
   ],
   "emberEcho": [
    "有朋自远方来——来信，即复。"
   ],
   "keep": [
    "灯为君留。"
   ],
   "fine": [
    "此页无追踪、无埋点、无第三方。",
    "一砖一瓦，皆是手作。"
   ]
  },
  "aboutLines": [
   [
    "白日，我在病理的毫厘之间，",
    "为临床求一份可用的证据。"
   ],
   [
    "入夜，一句话点燃一个念头，",
    "众智传薪，把它烧成产品。"
   ],
   [
    "我信小而亮的东西：",
    "一灯点亮，能燃百灯。"
   ]
  ],
  "lampDescs": [
   [
    "每天拂晓，把科学智能与生医的微末信号，",
    "读成三分钟晨报——见微，知著。"
   ],
   [
    "把散落的检查、文献与随访，织成一张可以",
    "问询的图谱——观水，必观其澜。"
   ],
   [
    "一部博士论文的舆图：章节、论断、代码、",
    "实验，按图索骥，层层放大。"
   ],
   [
    "中国双层股权研究工作台：披露、治理、监",
    "管动态，尽收一屏，明察秋毫。"
   ],
   [
    "一句话说出想动的念头，剩下的运筹组局，",
    "交给智能。"
   ],
   [
    "可信的病理智能助手，读片如老吏断案。"
   ],
   [
    "学术会议的私人驾驶舱：会前庙算，会中引",
